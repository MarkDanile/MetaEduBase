DATABASE_URL=postgresql+asyncpg://metaedu:dev_only_123@localhost:5432/metaedu
DATABASE_URL_SYNC=postgresql://metaedu:dev_only_123@localhost:5432/metaedu
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=metaedu
MINIO_SECRET_KEY=dev_only_123

# BUG-017: ENVIRONMENT = production 时启动校验 JWT_SECRET（必填、非默认、>=32 字符）。
# development（默认）保留可运行默认值，仅用于本地。
ENVIRONMENT=development
# 生产必填：随机 >=32 字符密钥（例：openssl rand -hex 32）。缺失/默认值/过短启动 fail-fast。
JWT_SECRET=

# R1-S2 S2-D：actor erasure HMAC secret（与 JWT_SECRET 隔离，密钥用途隔离）。
# 生产必填：随机 >=32 字符（例：openssl rand -hex 32）。V1 冻结期禁止轮换 secret/version
# （digest key version 未持久化，轮换会使历史 actor digest 孤儿化；启动期 fingerprint
# 比对 system_key_fingerprints 检测静默替换）。development 留空退化到 dev 占位。
ACTOR_ERASURE_SECRET=

MINIMAX_API_KEY=your-minimax-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
QWEN_API_KEY=your-qwen-api-key
SILICONFLOW_API_KEY=your-siliconflow-api-key

# REQ-044: QCC MCP server credential (env-key reference only; inject the real token in the deployment environment)
QCC_MCP_TOKEN=

# REQ-046: in-process Internal Customer MCP (V0 single-tenant binding)
INTERNAL_MCP_TENANT_ID=
INTERNAL_MCP_TOKEN=

# REQ-046 PR-5: catalog UUID holding the internal park datasets for
# internal_query semantic-model resolution (V0 single-tenant; the
# park_operations catalog created by upload_park_datasets.py)
DD_INTERNAL_QUERY_CATALOG_ID=
