POSTGRES_DB=metaedu
POSTGRES_USER=metaedu
POSTGRES_PASSWORD=CHANGE_ME_strong_pg_password

REDIS_PASSWORD=CHANGE_ME_strong_redis_password

MINIO_ACCESS_KEY=metaedu
MINIO_SECRET_KEY=CHANGE_ME_strong_minio_password

JWT_SECRET=CHANGE_ME_random_jwt_secret_at_least_32_chars

# R1-S2 S2-D：生产环境标识 + actor erasure HMAC secret（与 JWT_SECRET 隔离）。
# ENVIRONMENT=production 触发启动校验（secret 强度 + 版本冻结 V1 + fingerprint 锁定）。
# ACTOR_ERASURE_SECRET 随机 >=32 字符（例：openssl rand -hex 32），V1 冻结期禁止轮换
# （轮换会使历史 actor digest 孤儿化；启动期 fingerprint 比对 system_key_fingerprints
# 检测静默替换）。缺失/弱值启动 fail-fast。
ENVIRONMENT=production
ACTOR_ERASURE_SECRET=CHANGE_ME_random_actor_erasure_secret_at_least_32_chars

LLM_DEFAULT_PROVIDER=minimax
MINIMAX_API_KEY=

HTTP_PORT=80
