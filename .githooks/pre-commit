#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

started_at=$SECONDS
server_python_files=()
mcp_python_files=()
frontend_files=()
has_engineering_docs=false
has_mcp_lock_input=false

while IFS= read -r -d '' file; do
  case "$file" in
    packages/server-python/*.py|packages/server-python/**/*.py)
      server_python_files+=("$file")
      ;;
    packages/mcp-server/*.py|packages/mcp-server/**/*.py)
      mcp_python_files+=("$file")
      ;;
    packages/mcp-server/pyproject.toml|packages/mcp-server/uv.lock)
      has_mcp_lock_input=true
      ;;
    packages/web/*.ts|packages/web/*.vue|packages/web/**/*.ts|packages/web/**/*.vue)
      frontend_files+=("${file#packages/web/}")
      ;;
    AGENTS.md|CLAUDE.md|docs/*|scripts/engineering/*|tests/engineering/*)
      has_engineering_docs=true
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [[ ${#server_python_files[@]} -gt 0 ]]; then
  if [[ ! -x packages/server-python/.venv/bin/python ]]; then
    echo "[pre-commit] Missing backend environment; run: uv sync --project packages/server-python --frozen --extra dev" >&2
    exit 1
  fi
  echo "[pre-commit] Ruff on staged backend files..."
  packages/server-python/.venv/bin/python -m ruff check "${server_python_files[@]}"
fi

if [[ ${#mcp_python_files[@]} -gt 0 ]]; then
  if [[ ! -x packages/mcp-server/.venv/bin/python ]]; then
    echo "[pre-commit] Missing MCP environment; run: uv sync --project packages/mcp-server --frozen" >&2
    exit 1
  fi
  echo "[pre-commit] Ruff on staged MCP files..."
  packages/mcp-server/.venv/bin/python -m ruff check "${mcp_python_files[@]}"
fi

if [[ ${#frontend_files[@]} -gt 0 ]]; then
  if ! command -v pnpm >/dev/null 2>&1; then
    echo "[pre-commit] pnpm is required for frontend lint." >&2
    exit 1
  fi
  echo "[pre-commit] ESLint on staged frontend files..."
  (
    cd packages/web
    pnpm exec eslint "${frontend_files[@]}"
  )
fi

if [[ "$has_mcp_lock_input" == true ]]; then
  echo "[pre-commit] Checking MCP lockfile..."
  uv lock --check --project packages/mcp-server
fi

if [[ "$has_engineering_docs" == true ]]; then
  echo "[pre-commit] Running engineering documentation gate..."
  scripts/check-engineering-docs
fi

echo "[pre-commit] All checks passed in $((SECONDS - started_at))s."
