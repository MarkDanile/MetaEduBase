#!/usr/bin/env bash
set -euo pipefail

BRANCH=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)

if [[ "$BRANCH" == "main" || "$BRANCH" == "master" ]]; then
  echo "[pre-push] 直接推送到 $BRANCH 被拦截"
  echo "[pre-push] 请使用功能分支 + PR 流程:"
  echo "  git switch -c feature/your-feature"
  echo "  git push origin feature/your-feature"
  echo "  gh pr create --fill"
  exit 1
fi

echo "[pre-push] 推送分支检查通过：$BRANCH"
